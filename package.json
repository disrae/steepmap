    "deploy": "wrangler deploy",
    "tiles:upload": "./tiles/upload.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "pmtiles": "^3.2.1",
    "serve": "^14.2.6",
    "wrangler": "^4.149.0"
  }
}
