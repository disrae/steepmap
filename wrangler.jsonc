// Steepmap on Cloudflare. `npm run deploy` publishes the app; `npm run tiles:upload` puts trail files in R2.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "steepmap",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-10",
  // one address only, so offline maps are always saved under steepmap.ca
  "routes": [
    { "pattern": "steepmap.ca", "custom_domain": true },
    { "pattern": "www.steepmap.ca", "custom_domain": true }
  ],
  "workers_dev": false, // steepmap.ca only
  "preview_urls": false,
  "assets": {
    // the app; trail files are excluded by web/.assetsignore and served from R2 by the Worker instead.
    // Plain 404s for missing files, so a missing trail file is never answered with the HTML page.
    "directory": "./web",
    "binding": "ASSETS",
    "run_worker_first": true // every request, so http:// and www. redirect before any page loads
  },
  "r2_buckets": [
    { "binding": "TILES", "bucket_name": "steepmap-tiles" }
  ],
  "observability": { "enabled": true }
}
